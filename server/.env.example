# Скопируйте в .env и поменяйте значения. Файл .env в репозиторий не кладём.
STAROSTA_DATABASE_URL=sqlite:///./dev.db
# на сервере: STAROSTA_DATABASE_URL=postgresql+psycopg://starosta:ПАРОЛЬ@db:5432/starosta
STAROSTA_APP_ORIGIN=http://127.0.0.1:8765
STAROSTA_COOKIE_SECURE=false
# python -c "import secrets; print(secrets.token_urlsafe(32))"
STAROSTA_SECRET_KEY=dev-only-change-me
STAROSTA_MAIL_DOMAIN=in.starosta.local
STAROSTA_MAIL_RETENTION_DAYS=60
