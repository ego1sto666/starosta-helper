# Скопируйте в .env и поменяйте значения. Файл .env в репозиторий не кладём.
STAROSTA_DATABASE_URL=sqlite:///./dev.db
# на сервере: STAROSTA_DATABASE_URL=postgresql+psycopg://starosta:ПАРОЛЬ@db:5432/starosta
STAROSTA_APP_ORIGIN=http://127.0.0.1:8765
STAROSTA_COOKIE_SECURE=false
# python -c "import secrets; print(secrets.token_urlsafe(32))"
STAROSTA_SECRET_KEY=dev-only-change-me
STAROSTA_MAIL_DOMAIN=in.starosta.local
STAROSTA_MAIL_RETENTION_DAYS=60
# Дополнительный IMAP-хост вуза, если нужен. Можно перечислить через запятую.
STAROSTA_MAIL_IMAP_HOSTS=
# Секрет доверенного HTTPS-шлюза почты, минимум 32 символа. Оставьте пустым без шлюза.
STAROSTA_MAIL_RELAY_TOKEN=
# Web Push: python tools/push_keys.py secrets/vapid.pem
STAROSTA_PUSH_PUBLIC_KEY=
STAROSTA_PUSH_PRIVATE_KEY_FILE=
STAROSTA_PUSH_SUBJECT=
# Один пробный чат Telegram: токен BotFather, отрицательный ID чата и ID облачной группы.
STAROSTA_TELEGRAM_TOKEN=
STAROSTA_TELEGRAM_CHAT_ID=0
STAROSTA_TELEGRAM_GROUP_ID=
