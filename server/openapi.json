      "title": "Rev"
     },
     "data": {
      "additionalProperties": true,
      "type": "object",
      "title": "Data"
     }
    },
    "type": "object",
    "required": [
     "rev",
     "data"
    ],
    "title": "DataIn"
   },
   "DecideIn": {
    "properties": {
     "type": {
      "type": "string",
      "maxLength": 20,
      "title": "Type",
      "default": "none"
     },
     "id": {
      "type": "string",
      "maxLength": 40,
      "title": "Id",
      "default": ""
     }
    },
    "type": "object",
    "title": "DecideIn"
   },
   "ForgotIn": {
    "properties": {
     "email": {
      "type": "string",
      "format": "email",
      "title": "Email"
     }
    },
    "type": "object",
    "required": [
     "email"
    ],
    "title": "ForgotIn"
   },
   "GroupIn": {
    "properties": {
     "title": {
      "type": "string",
      "maxLength": 60,
      "minLength": 1,
      "title": "Title"
     },
     "nntu_group": {
      "type": "string",
      "maxLength": 60,
      "title": "Nntu Group",
      "default": ""
     },
     "data": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Data"
     }
    },
    "type": "object",
    "required": [
     "title"
    ],
    "title": "GroupIn"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "ImapIn": {
    "properties": {
     "provider": {
      "type": "string",
      "pattern": "^(yandex|mailru|gmail|other)$",
      "title": "Provider"
     },
     "login": {
      "type": "string",
      "maxLength": 254,
      "title": "Login"
     },
     "password": {
      "type": "string",
      "maxLength": 500,
      "minLength": 1,
      "title": "Password"
     },
